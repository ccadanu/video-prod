# Variabel untuk deployment EKSTERNAL: Hetzner VPS + Coolify. Hanya cabang deploy-external.
# Isi di Coolify (aplikasi → Environment Variables). JANGAN simpan nilai asli di git.
# Panduan: docs/DEPLOY_EXTERNAL.md

# ───────────── WAJIB ─────────────
# Alamat database Postgres: salin "Postgres URL (internal)" dari resource database di Coolify.
# (Alamat internal hanya terjangkau dari aplikasi di server yang sama; jangan buka port database ke internet.)
DATABASE_URL=postgres://ccp:GANTI@ccp-db:5432/ccp

# Admin awal. Dibuat otomatis HANYA bila belum ada pengguna sama sekali (tidak pernah menimpa akun).
# Setelah login pertama: ganti kata sandi, lalu HAPUS dua variabel ini dan deploy ulang.
BOOTSTRAP_ADMIN_EMAIL=admin@perusahaan.co.id
BOOTSTRAP_ADMIN_PASSWORD=GANTI-dengan-kata-sandi-acak-min-12-karakter
# BOOTSTRAP_ADMIN_NAME=Admin

# ───────────── Disarankan tetap default ─────────────
# NODE_ENV sudah di-set di image; tulis ulang hanya bila Coolify meminta.
NODE_ENV=production
# Wajib HTTPS (Coolify menyediakan HTTPS otomatis lewat Let's Encrypt).
COOKIE_SECURE=true
# Lama sesi login dalam jam (168 = 7 hari).
SESSION_TTL_HOURS=168
LOG_LEVEL=info

# Samakan dengan "Ports Exposes" di aplikasi Coolify.
PORT=3001

# ───────────── Hanya bila perlu (pemecahan masalah) ─────────────
# Bila setiap aksi simpan ditolak 403 "Origin tidak diizinkan" (proxy mengubah header Host), isi dengan alamat publik aplikasi:
# ALLOWED_ORIGINS=https://video.perusahaan.co.id
