# Salin menjadi .env (JANGAN di-commit) lalu isi.

# ── Database (dipakai compose untuk membuat Postgres dan merakit DATABASE_URL) ──
POSTGRES_USER=ccp
POSTGRES_DB=ccp
POSTGRES_PASSWORD=            # wajib: gunakan kata sandi acak panjang (mis. `openssl rand -base64 24`)

# ── Akses ──
# HTTPS (disarankan): COOKIE_SECURE=true. Hanya bila sengaja memakai HTTP di jaringan internal: false.
COOKIE_SECURE=true
# Alamat luar bila memakai profil Caddy (domain yang mengarah ke server ini).
# DOMAIN=video.contoh.co.id
# Hanya bila web diakses dari origin yang berbeda dari API (jarang). Kosongkan untuk satu origin.
# ALLOWED_ORIGINS=
# Publikasi port aplikasi: 127.0.0.1 (di belakang proxy) atau 0.0.0.0 (langsung dari jaringan).
APP_BIND=127.0.0.1
APP_PORT=3001

# ── Aplikasi ──
SESSION_TTL_HOURS=168
LOG_LEVEL=info

# ── Admin awal (hanya dipakai sekali oleh `seed`; ganti kata sandinya setelah login pertama) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
