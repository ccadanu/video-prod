# Semua opsional untuk pengembangan lokal.
PORT=3001
# Postgres mana pun: server internal, Docker, atau layanan terkelola. Kosong = Postgres tertanam di data/pgdata (dev).
# DATABASE_URL=postgres://ccp:ccp@localhost:5432/ccp
# DATABASE_POOL_MAX=10
SESSION_TTL_HOURS=168
# Origin web yang boleh memanggil API bila beda origin (kosongkan bila web & /api satu origin lewat reverse proxy).
ALLOWED_ORIGINS=http://localhost:5173
# 'lax' (default) bila web & API satu situs. 'none' bila beda situs (wajib HTTPS).
# COOKIE_SAMESITE=lax
# Hanya untuk `NODE_ENV=production npm run seed` (membuat admin awal):
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
