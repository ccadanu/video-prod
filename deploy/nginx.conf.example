# Contoh Nginx di depan aplikasi (bila server sudah punya Nginx/IIS/Apache). Aplikasi sudah melayani web + /api sendiri,
# jadi cukup meneruskan semuanya ke port 3001. Pastikan HTTPS (cookie sesi Secure).
server {
    listen 443 ssl;
    server_name video.contoh.co.id;
    ssl_certificate     /etc/ssl/video.crt;
    ssl_certificate_key /etc/ssl/video.key;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
